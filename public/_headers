# Netlify / Cloudflare Pages header rules. Harmless on any other host — it is
# just a static file there. If you deploy to Vercel, port these to vercel.json;
# to S3+CloudFront, to a response-headers policy.
#
# No Content-Security-Policy here on purpose: the site loads Google Fonts and,
# once PUBLIC_CALENDLY_URL is set, the Calendly widget + its iframe. A CSP
# written blind would break the booking page, which is the primary conversion.
# Add one after launch by reading the real request log.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Astro fingerprints these filenames, so they can never go stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images are not fingerprinted — a week, so a re-shoot goes live without waiting
# out a year-long cache.
/images/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800

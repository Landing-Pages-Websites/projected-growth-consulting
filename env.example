# Copy to .env and fill in. Everything here is PUBLIC_ — Astro inlines these
# into the built HTML at build time, so never put a secret in this file.
# All of them are optional; each unset value degrades to a working fallback
# rather than a broken control.

# Calendly event URL for /book-a-call. Unset -> a "Request A Time" CTA into
# /contact-us instead of an empty widget box.
# PUBLIC_CALENDLY_URL="https://calendly.com/<org>/<event>"

# POST handler for the /contact-us form (Formspree, Netlify Forms, HubSpot, or
# your own SSR route). Unset -> the form is hidden and the page shows the
# direct email/phone panel, because a form with no endpoint loses enquiries.
# The form posts a `company-website` honeypot field: reject any submission
# where it is non-empty.
# PUBLIC_FORM_ENDPOINT="https://formspree.io/f/xxxxxxxx"

# POST handler for the blog newsletter box. Unset -> the box is not rendered.
# PUBLIC_NEWSLETTER_ENDPOINT="https://..."

# GA4 measurement ID. Unset -> no analytics script, no cookies, nothing to
# consent to. Set it and page_view also fires on view-transition navigations.
# PUBLIC_GA4_ID="G-XXXXXXXXXX"

# Search Console HTML-tag verification. Only needed if you verify by meta tag
# rather than DNS — DNS is the better choice, it survives redeploys.
# PUBLIC_GSC_VERIFICATION="..."

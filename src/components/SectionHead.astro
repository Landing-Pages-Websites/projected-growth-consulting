---
/**
 * The section header used site-wide: eyebrow + display heading (left) over
 * body + optional CTA (right).
 *
 * Desktop: 659px title column, 60px gap, 561px body column (= the 1280 rail),
 * bottoms aligned. Both widths
 * are flex bases (never shrink-0) so they compress in the 659:561 ratio below the
 * 1440px design width instead of overflowing the rail. Keep that ratio HERE only —
 * this file previously existed twice (the second copy under sections/growth-hub/)
 * and the two drifted on eyebrow tracking and column shrink behaviour.
 */
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Pass an array to keep Figma's explicit line breaks. */
  body: string | string[];
  cta?: { label: string; href: string };
  /**
   * Mobile-only alignment (desktop is always title-left / body-right):
   * 'default' — eyebrow + CTA centred, copy left  (growth-hub, blog, pgc-proof)
   * 'center'  — everything centred                (press, consulting, about, resources)
   * 'left'    — everything left                   (book-a-call)
   */
  align?: 'default' | 'center' | 'left';
  /** Keep the stacked, centred layout at every width. /courses "Course Collection" (159:12772). */
  centered?: boolean;
  /**
   * Body type scale. Default is the 16px every page currently ships; mobile
   * frames that drop to 14px pass 'text-sm lg:text-base' (/consulting Choose
   * Your Path, Figma 159:23763).
   */
  bodyClass?: string;
}

const {
  eyebrow,
  title,
  body,
  cta,
  align = 'center',
  centered = false,
  bodyClass = 'text-base',
} = Astro.props;
const paragraphs = Array.isArray(body) ? body : [body];
const split = !centered;
---

<div
  class:list={[
    'flex w-full flex-col gap-8',
    align === 'center' && 'items-center text-center',
    align === 'left' && 'items-start',
    split && 'lg:flex-row lg:items-end lg:justify-between lg:gap-15 lg:text-left',
  ]}
>
  <div
    class:list={[
      'flex flex-col gap-3 text-[#111827]',
      split ? 'lg:basis-[659px] lg:min-w-0 lg:grow' : 'max-w-[659px]',
    ]}
  >
    {/* Figma 159:12430 / 159:23003 — 16px/20 Inter Regular at -1px, not 12px/500. */}
    <p
      class:list={[
        'eyebrow text-base leading-5 font-normal tracking-[-1px]',
        align === 'default' && 'text-center lg:text-left',
      ]}
    >
      {eyebrow}
    </p>
    <h2 class="text-[2.5rem] lg:text-[4rem]">{title}</h2>
  </div>

  <div
    class:list={[
      'flex flex-col gap-8',
      align === 'left' ? 'items-start' : 'items-center',
      split ? 'lg:basis-[561px] lg:min-w-0 lg:grow lg:items-end lg:justify-end' : 'max-w-[561px]',
    ]}
  >
    <div
      class:list={[
        'w-full leading-6 tracking-[-1px] text-[#6b7280]',
        bodyClass,
        split && 'lg:text-right',
      ]}
    >
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    {
      cta && (
        <Button href={cta.href} size="lg">
          {cta.label}
        </Button>
      )
    }
  </div>
</div>

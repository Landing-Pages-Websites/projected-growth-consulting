---
/**
 * Transparent header overlaid on every page hero.
 * Figma 159:4045 — 80px gutters, 24px vertical, 1px rgba(255,255,255,.1) hairline.
 */
import { primaryNav } from '../lib/site';
import Button from './Button.astro';

interface Props {
  /**
   * Almost every hero is a darkened photo, so the header is cream-on-dark by
   * default. Pages whose hero is the cream, image-less variant pass `light`,
   * or the whole nav renders cream-on-cream — i.e. invisible.
   *
   * This replaces two copies of a `body:has(section[data-node-id=…]) > header`
   * repaint (blog-post/Hero.astro, privacy-policy.astro), both of which named
   * this prop as the real fix. A third page (/404) was about to need a third.
   */
  theme?: 'dark' | 'light';
}

const { theme = 'dark' } = Astro.props;
const light = theme === 'light';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const linkIdle = light
  ? 'text-[#6b7280] hover:text-[var(--color-lime-border)]'
  : 'text-[var(--color-cream)] hover:text-[var(--color-lime)]';
const linkActive = light ? 'text-[var(--color-lime-border)]' : 'text-[var(--color-lime)]';
---

<header
  class:list={[
    'absolute inset-x-0 top-0 z-50 border-b',
    light ? 'border-black/10' : 'border-white/10',
  ]}
  data-node-id="159:4045"
>
  <div class="rail flex items-center justify-between py-6">
    <div class="flex items-center gap-8">
      <a href="/" class="block size-10 shrink-0 overflow-hidden" aria-label="Projected Growth Consulting — home">
        <!-- Figma crops the wide lockup down to the "G" mark: 40 / 186.18 = 21.5% -->
        <img
          src="/images/logo-lockup.png"
          alt=""
          class="h-full max-w-none"
          style="width:465.45%"
          width="186"
          height="40"
        />
      </a>

      <nav class="hidden items-center gap-3 lg:flex" aria-label="Primary">
        {
          primaryNav.map((item) =>
            item.children ? (
              <div class="group relative" data-dropdown>
                {/* The parent is a real link to a real page, and the panel opens
                    on :hover and :focus-within, so mouse and keyboard both
                    reach the children with no JS. What CSS alone cannot do is
                    a tap on a touch laptop (no hover) or Escape to dismiss —
                    the toggle below adds exactly those two, and only when JS
                    is available. aria-expanded is therefore set from script,
                    never hardcoded, so it can't lie in the no-JS case. */}
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-1 rounded-lg py-2 pl-3 pr-2 text-sm leading-4 font-medium tracking-[-1px] transition-colors',
                    isActive(item.href) ? linkActive : linkIdle,
                  ]}
                  aria-haspopup="true"
                  data-dropdown-trigger
                >
                  {item.label}
                  <img src="/icons/chevron-down.svg" alt="" aria-hidden="true" width="16" height="16" class="size-4 transition-transform group-hover:rotate-180 group-data-[open]:rotate-180" />
                </a>
                <div class="invisible absolute left-0 top-full w-56 translate-y-1 rounded-lg border border-black/5 bg-white p-2 opacity-0 shadow-lg transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-data-[open]:visible group-data-[open]:translate-y-0 group-data-[open]:opacity-100">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-md px-3 py-2 text-sm font-medium text-[var(--color-navy)] transition-colors hover:bg-[var(--color-surface)]"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm leading-4 font-medium tracking-[-1px] transition-colors',
                  isActive(item.href) ? linkActive : linkIdle,
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          )
        }
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <Button href="/growth-hub" class="hidden sm:inline-flex">Join The Growth Hub</Button>

      <button
        type="button"
        class:list={[
          'flex size-10 items-center justify-center rounded-lg lg:hidden',
          light ? 'text-[#6b7280]' : 'text-[var(--color-cream)]',
        ]}
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-nav"
    hidden
    class="border-t border-white/10 bg-[var(--color-navy)] lg:hidden"
  >
    <nav class="rail flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        primaryNav.map((item) => (
          <>
            <a href={item.href} class="rounded-lg px-3 py-3 text-base font-medium text-[var(--color-cream)]">
              {item.label}
            </a>
            {item.children?.map((child) => (
              <a href={child.href} class="rounded-lg py-2 pl-7 pr-3 text-sm text-[var(--color-ink-100)]">
                {child.label}
              </a>
            ))}
          </>
        ))
      }
      <Button href="/growth-hub" size="lg" class="mt-3 w-full sm:hidden">Join The Growth Hub</Button>
    </nav>
  </div>
</header>

<script>
  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const drawer = document.getElementById('mobile-nav');
    if (!toggle || toggle.dataset.menuBound) return;
    toggle.dataset.menuBound = '1';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (drawer) drawer.hidden = !open;
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    // Close the drawer after tapping a link (view-transition nav keeps the DOM).
    drawer?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }

  // Desktop dropdown: adds the two things :hover/:focus-within cannot do —
  // open on tap where there is no hover, and dismiss with Escape.
  function initDropdowns() {
    document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((wrap) => {
      if (wrap.dataset.bound) return;
      wrap.dataset.bound = '1';
      const trigger = wrap.querySelector<HTMLAnchorElement>('[data-dropdown-trigger]');
      if (!trigger) return;
      trigger.setAttribute('aria-expanded', 'false');

      const setOpen = (open: boolean) => {
        wrap.toggleAttribute('data-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };

      trigger.addEventListener('click', (e) => {
        // Only hijack the navigation where hover is unavailable; on a mouse the
        // panel is already open and the link should still go to its page.
        if (window.matchMedia('(hover: hover)').matches) return;
        if (wrap.hasAttribute('data-open')) return; // second tap follows the link
        e.preventDefault();
        setOpen(true);
      });

      wrap.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key !== 'Escape') return;
        setOpen(false);
        trigger.focus();
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) setOpen(false);
      });
    });
  }

  document.addEventListener('astro:page-load', initMenu);
  document.addEventListener('astro:page-load', initDropdowns);
</script>

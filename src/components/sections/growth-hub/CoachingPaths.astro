---
/** "Choose Your Coaching Path" — Figma desktop 159:9751 / mobile 159:21138. */
import SectionHead from '../../SectionHead.astro';
import DarkCard from '../../DarkCard.astro';

const cards = [
  {
    image: '/images/growth-hub/path-executive-coaching.png',
    alt: 'Kelly Smith in a private one-to-one coaching session with a practice owner',
    kicker: 'Private 1:1 Coaching With Kelly Smith',
    title: 'Executive Coaching',
    body: 'Direct access to personalized guidance, strategic planning, leadership development, and business growth support.',
  },
  {
    image: '/images/growth-hub/path-growth-accelerator.jpg',
    alt: 'Group coaching session with several practice owners around a table',
    kicker: 'Group Coaching & Accountability',
    title: 'Growth Accelerator',
    body: 'A structured growth program combining coaching, implementation support, KPI tracking, and peer accountability.',
  },
  {
    image: '/images/growth-hub/path-mastermind.png',
    alt: 'Mastermind group of practice owners working through a strategy session',
    kicker: 'Peer Collaboration & Advanced Strategy',
    title: 'Mastermind',
    body: 'Join a community of growth-focused practice owners committed to scaling, sharing insights, and solving challenges together.',
  },
];
---

<section data-node-id="159:9751" class="bg-[#f6f3ec] py-20">
  <div class="rail flex flex-col gap-16">
    <SectionHead
      eyebrow="THREE WAYS TO GROW"
      title="Coaching Designed For Every Stage"
      body={[
        'Select the coaching experience that best aligns with your goals,',
        'leadership style, and business stage.',
      ]}
      cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    />

    <ul class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card, i) => (
          <li class:list={[i === cards.length - 1 && 'md:max-lg:col-span-2']}>
            <DarkCard {...card} width="900" height="600" class="justify-center" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

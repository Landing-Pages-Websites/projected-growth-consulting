---
/**
 * Photo beside a checklist of white pills — the shape of both "The Real Issue"
 * (159:8327, photo right) and "Who It's For" (159:9636, photo left).
 * Mobile (159:19714 / 159:21023) puts the photo on top as a square in both.
 */
import Button from '../../Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  /** The bold line that introduces the checklist. */
  listTitle: string;
  items: string[];
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  /** Which side the photo sits on from lg up. Mobile is always photo-first. */
  imageSide?: 'left' | 'right';
  cta: { label: string; href: string };
  nodeId: string;
}

const {
  eyebrow,
  title,
  body,
  listTitle,
  items,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageSide = 'right',
  cta,
  nodeId,
} = Astro.props;
---

<section data-node-id={nodeId} class="bg-[#f6f3ec] py-20">
  <div
    class:list={[
      'rail flex flex-col gap-10 lg:items-stretch',
      imageSide === 'right' ? 'lg:flex-row-reverse' : 'lg:flex-row',
    ]}
  >
    {/* min-h-0: as a column flex item this div's automatic minimum size is its
        content, which let the 2:3 photo out-vote `aspect-square` and render 524px
        tall instead of Figma's 349 (159:19715 / 159:21024). */}
    <div class="aspect-square w-full min-h-0 shrink-0 lg:aspect-auto lg:w-[calc(50%-1.25rem)]">
      <img
        src={image}
        alt={imageAlt}
        width={imageWidth}
        height={imageHeight}
        loading="lazy"
        decoding="async"
        class="size-full rounded-2xl object-cover"
      />
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-6">
      <div class="flex flex-col gap-3">
        <p class="eyebrow text-center text-base tracking-[-1px] text-[#111827] lg:text-left">
          {eyebrow}
        </p>
        {/* Mobile centres the eyebrow, title and body; desktop is left-aligned. */}
        <h2 class="text-center text-[2.5rem] text-[#111827] lg:text-left lg:text-[4rem]">
          {title}
        </h2>
        <p
          class="text-center text-base leading-6 tracking-[-1px] text-[#6b7280] lg:text-left"
        >
          {body}
        </p>
      </div>

      <p class="text-xl leading-6 font-semibold tracking-[-0.04em] text-[#111]">{listTitle}</p>

      <ul class="flex flex-col gap-4">
        {
          items.map((item) => (
            <li class="flex items-center gap-2 rounded border border-black/10 bg-white p-4">
              <img
                src="/icons/check-circle-24-lime.svg"
                alt=""
                aria-hidden="true"
                width="24"
                height="24"
                loading="lazy"
                class="size-6 shrink-0"
              />
              <span class="text-base leading-6 font-medium tracking-[-0.04em] text-[#6b7280]">
                {item}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="flex justify-center lg:justify-start">
        <Button href={cta.href} size="lg">{cta.label}</Button>
      </div>
    </div>
  </div>
</section>

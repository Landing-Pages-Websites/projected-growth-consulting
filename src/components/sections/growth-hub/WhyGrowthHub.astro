---
/** "What Is The Growth Hub?" — Figma desktop 159:8392 / mobile 159:19779. */
import SectionHead from '../../SectionHead.astro';
import DarkCard from '../../DarkCard.astro';

const cards = [
  {
    image: '/images/growth-hub/why-one-hour-solutions.jpg',
    alt: 'Practice owner working through a one-hour implementation lesson on a laptop',
    title: 'One-Hour Solutions',
    body: 'Every lesson solves one specific business problem in about an hour.',
  },
  {
    image: '/images/growth-hub/why-delegate.jpg',
    alt: 'Practice manager briefing a team member on an assigned lesson',
    title: 'Delegate To Your Team',
    body: "Assign lessons to managers and staff so implementation doesn't always fall on the owner.",
  },
  {
    image: '/images/growth-hub/why-real-experience.png',
    alt: 'Kelly Smith coaching an elective medical practice owner',
    title: 'Built From Real Experience',
    body: 'Learn the exact systems Kelly Smith has used to help thousands of elective medical practices grow.',
  },
  {
    image: '/images/growth-hub/why-ready-to-implement.jpg',
    alt: 'Printed templates, scripts and checklists laid out on a desk',
    title: 'Ready To Implement',
    body: 'Templates, scripts, scorecards, checklists, and tools are included with every lesson.',
  },
];
---

<section data-node-id="159:8392" class="bg-[#f6f3ec] py-20">
  <div class="rail flex flex-col gap-12">
    <SectionHead
      eyebrow="WHY GROWTH HUB"
      title="Stop Collecting Information. Start Solving Problems."
      body="You don't need another consultant giving you more homework or another 12-hour course you'll never finish. Growth Hub delivers quick, practical solutions your team can implement immediately—so your business keeps moving forward without everything depending on you."
      cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    />

    <ul class="grid gap-6 grid-cols-1 md:grid-cols-2 xl:grid-cols-4">
      {
        cards.map((card) => (
          <li>
            <DarkCard {...card} width="900" height="600" class="justify-center" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
/** "Coaching Included" — Figma desktop 159:9701 / mobile 159:21088. */
import IconCard from '../../IconCard.astro';
import SectionHead from '../../SectionHead.astro';

const cards = [
  {
    icon: '/icons/coaching-calls.svg',
    title: 'Monthly Coaching Calls',
    body: 'Join live implementation sessions with Kelly Smith and get answers to your biggest business challenges.',
  },
  {
    icon: '/icons/coaching-community.svg',
    title: 'Private Owner Community',
    body: "Connect with elective medical practice owners, exchange ideas, and learn what's working right now.",
  },
  {
    icon: '/icons/coaching-accountability.svg',
    title: 'Accountability Tools',
    body: 'Stay focused using KPI dashboards, Executive Goal Trackers, and structured action plans.',
  },
  {
    icon: '/icons/coaching-updates.svg',
    title: 'Ongoing Updates',
    body: 'Receive new one-hour lessons, templates, AI resources, and implementation tools every month.',
  },
];
---

<section data-node-id="159:9701" class="bg-[#f6f3ec] py-20">
  <div data-reveal class="rail flex flex-col gap-16">
    <SectionHead
      eyebrow="COACHING INCLUDED"
      title="Learn Independently. Grow Together."
      body="Growth Hub combines self-paced implementation with expert coaching, accountability, and a community of practice owners committed to building stronger businesses."
      cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    />

    <ul class="grid gap-6 grid-cols-1 md:grid-cols-2 xl:grid-cols-4">
      {
        cards.map((card) => <IconCard icon={card.icon} title={card.title} body={card.body} />)
      }
    </ul>
  </div>
</section>

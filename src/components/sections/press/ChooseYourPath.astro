---
/**
 * /press — "Choose Your Path". Figma desktop 159:17788 · mobile 159:25932.
 * Shared SectionHead (659:561 columns) then two dark cards side by side.
 * Mobile centres the header and stacks the cards.
 */
import DarkCard from '../../DarkCard.astro';
import SectionHead from '../../SectionHead.astro';

const cards = [
  {
    image: '/images/press/path-coaching.jpg',
    alt: 'Kelly Smith presenting to seated practice owners at a Projected Growth Consulting workshop',
    width: 1400,
    height: 1400,
    kicker: 'You Don’t To Have Be In Business Alone!',
    title: 'Coaching and Consulting',
    body: 'Our medical spa business consulting teaches you how to grow your practice to over 6-7 Figures in sales.',
  },
  {
    image: '/images/press/path-sales-events.jpg',
    alt: 'Med spa owners around a conference table at a PGC onsite sales event, a copy of Top 10 Profit Killers in the foreground',
    width: 1400,
    height: 1400,
    kicker: 'Each sales event generated an avergae of $62,000 in revenue.',
    title: 'Onsite Sales Events',
    body: 'PGC sales events generated a total of $18 Million in revenue for their medical spa clients every year.',
  },
];
---

<section data-node-id="159:17788" class="bg-[#f6f3ec] py-20">
  {/* 159:17789 ends at y=268, 159:17801 starts at y=332 — 64px, not 48. */}
  <div class="rail flex flex-col gap-16">
    <div data-reveal>
      <SectionHead
        align="center"
        eyebrow="How PGC Helps"
        title="Solutions For Every Growth Stage"
        body="Whether you're launching a new practice, improving operations, or preparing for long-term growth, PGC provides the tools, coaching, and strategies needed to achieve measurable results."
        cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
      />
    </div>

    <ul data-reveal-group class="grid gap-6 md:grid-cols-2">
      {
        cards.map((card) => (
          <li data-reveal>
            {/* 322 tall on both frames — 159:17803 desktop, 159:25948 mobile. */}
            <DarkCard {...card} imgClass="h-[322px] w-full rounded-[4px] object-cover" arrow />
          </li>
        ))
      }
    </ul>
  </div>
</section>

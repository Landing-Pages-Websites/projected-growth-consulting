---
/**
 * /press — "Podcast". Figma desktop 159:17820 · mobile 159:25965.
 * Desktop: 419px copy column, 801x450 video still on the right, tops aligned.
 * Mobile centres the copy and puts the still underneath.
 */
---

<section data-node-id="159:17820" class="bg-[#f6f3ec] py-20">
  <div
    data-reveal-group
    class="rail flex flex-col items-center gap-10 text-center lg:flex-row lg:items-start lg:justify-between lg:gap-[60px] lg:text-left"
  >
    <div data-reveal class="flex flex-col gap-3 lg:basis-[419px] lg:min-w-0">
      <p class="eyebrow text-base tracking-[-1px] text-[#111827]">Podcast</p>
      <h2 class="text-[2.5rem] tracking-[-0.04em] text-[#111827] lg:text-[4rem]">
        Trusted By Industry Leaders
      </h2>
      {/* Figma puts 32px between the heading and the body, 12px above it. */}
      <p class="mt-5 text-base leading-6 tracking-[-1px] text-[#6b7280]">
        Kelly regularly shares insights on leadership, growth strategy, memberships,
        profitability, recruiting, and practice valuation through conferences, workshops,
        podcasts, and industry events.
      </p>
    </div>

    <img
      data-reveal
      data-node-id="159:18951"
      src="/images/press/podcast.png"
      alt="Video still titled “Why I Started PGC” — Kelly Smith holding her book Top 10 Profit Killers for Plastic Surgeons &amp; Medical Spas"
      width="857"
      height="482"
      loading="lazy"
      decoding="async"
      class="w-full rounded-lg object-cover lg:basis-[801px] lg:min-w-0"
    />
  </div>
</section>

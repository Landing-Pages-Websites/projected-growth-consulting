---
/**
 * /press — "Seminar Topics". Figma desktop 159:18952 · mobile 159:25973.
 * Same header shape as Choose Your Path, then a 2x2 grid of dark topic cards.
 */
import DarkCard from '../../DarkCard.astro';
import SectionHead from '../../SectionHead.astro';

const topics = [
  {
    image: '/images/press/seminar-superstar-team.jpg',
    alt: 'A practice team gathered around laptops in an office, working through a plan together',
    width: 1400,
    height: 886,
    title: 'Scale With The Superstar Team',
    body: 'Build a high-performing team through a proven 5-step system covering recruiting, onboarding, training, accountability, and retention.',
    takeaways: [
      'Create an organizational structure that supports growth',
      'Avoid costly hiring mistakes with proven interview systems',
    ],
  },
  {
    image: '/images/press/seminar-kpis.jpg',
    alt: 'A laptop showing a performance dashboard of charts and KPIs on a desk',
    width: 1400,
    height: 933,
    title: 'The Power Of KPIs',
    body: 'Learn how to manage your practice using the numbers that directly impact revenue, productivity, and profitability.',
    takeaways: [
      'Track capacity, revenue per hour, and room utilization',
      'Understand production metrics that drive profit growth',
    ],
  },
  {
    image: '/images/press/seminar-memberships.jpg',
    alt: 'Two people shaking hands over a signed contract at a meeting table',
    width: 1400,
    height: 933,
    title: 'Harness The Power Of Memberships',
    body: 'Discover how recurring revenue programs increase patient loyalty, improve cash flow, and strengthen practice valuation.',
    takeaways: [
      'Design profitable and consumer-friendly membership programs',
      'Balance pricing, COGS, and value for long-term success',
    ],
  },
  {
    image: '/images/press/seminar-sell-practice.jpg',
    alt: 'A hand placing a dart in the centre of a target beside a laptop and printed charts',
    width: 1400,
    height: 933,
    title: 'Strategic Tactics To Sell Your Practice',
    body: 'Prepare your business for acquisition, partnership, succession, or future growth opportunities.',
    takeaways: [
      'Increase business valuation through operational improvements',
      'Build recurring revenue streams that attract buyers and investors',
    ],
  },
];
---

<section data-node-id="159:18952" class="bg-[#f6f3ec] py-20">
  {/* 159:18953 ends at y=268, the card grid starts at y=332 — 64px, not 48. */}
  <div class="rail flex flex-col gap-16">
    <div data-reveal>
      <SectionHead
        align="center"
        eyebrow="Signature Seminar Topics"
        title="Presentations That Drive Practice Growth"
        body="Actionable presentations packed with proven frameworks, real-world case studies, and implementation strategies for aesthetic medical practice owners and leadership teams."
        cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
      />
    </div>

    {/* Figma rows sit 32px apart (y=332 / y=978, cards 614 tall); columns 24px. */}
    <ul data-reveal-group class="grid gap-x-6 gap-y-8 md:grid-cols-2">
      {
        topics.map((topic) => (
          <li data-reveal>
            {/* 322 tall on both frames — 159:18967 desktop, 159:25990 mobile. */}
            <DarkCard {...topic} imgClass="h-[322px] w-full rounded-[4px] object-cover" arrow />
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
/**
 * PGC Growth App — Figma desktop 159:14918 / mobile 159:25419.
 * Desktop: app artwork left, copy + six white feature rows right (gap 40).
 * Mobile stacks artwork above the copy.
 */
import Button from '../../Button.astro';

type Feature = { label: string; body: string };

const features: Feature[] = [
  { label: 'Financial Benchmarking', body: 'Compare performance against industry standards.' },
  { label: 'KPI Tracking', body: 'Monitor growth with greater visibility.' },
  { label: 'Revenue Reporting', body: 'Understand trends and opportunities.' },
  { label: 'Staff Productivity', body: 'Measure individual and team performance.' },
  { label: 'Goal Tracking', body: 'Stay focused on business objectives.' },
  { label: 'Mobile Access', body: 'Review performance anytime, anywhere.' },
];
---

<section id="pgc-growth-app" data-node-id="159:14918" class="bg-[#f6f3ec] py-20">
  <div class="rail flex flex-col items-center gap-10 lg:flex-row">
    {/* Figma 159:25421 reserves a 350px-tall band for the artwork on mobile. */}
    <div class="flex h-[350px] w-full items-center lg:h-auto lg:min-w-0 lg:flex-1">
      <img
        src="/images/resources/card-growth-app.png"
        alt="The PGC Growth App dashboard showing revenue, KPI and productivity reporting for an elective medical practice"
        width="1715"
        height="1095"
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl"
      />
    </div>

    <div class="flex w-full flex-col gap-6 lg:min-w-0 lg:flex-1">
      <div class="flex flex-col gap-3">
        <p class="eyebrow text-base tracking-[-1px] text-[#111827]">Business Intelligence App</p>
        <h2 class="text-[2.5rem] text-[#111827] lg:text-[4rem]">Know Your Numbers In Minutes</h2>
        <p class="text-base leading-6 tracking-[-1px] text-[#6b7280]">
          Track the metrics that matter most with a business performance app built specifically for
          elective medical practices.
        </p>
      </div>

      <p class="text-center text-xl leading-6 font-semibold tracking-[-0.04em] text-[#111] lg:text-left">
        What&rsquo;s Included :
      </p>

      <ul class="flex flex-col gap-4">
        {
          features.map((feature) => (
            <li class="flex items-center gap-2 rounded-[4px] border border-black/10 bg-white p-6">
              <img
                src="/icons/check-circle-24-lime.svg"
                alt=""
                aria-hidden="true"
                width="24"
                height="24"
                loading="lazy"
                class="size-6 shrink-0"
              />
              {/* Figma 159:14937 — the copy column is 448px inside the 620px row,
                  so the first feature wraps to two lines. */}
              <p class="max-w-md text-base leading-6 tracking-[-0.04em] text-[#6b7280]">
                <span class="font-medium">{feature.label} :</span> {feature.body}
              </p>
            </li>
          ))
        }
      </ul>

      <Button href="/contact-us" size="lg" class="self-center lg:self-start">
        Starting at $9.99/month
      </Button>
    </div>
  </div>
</section>

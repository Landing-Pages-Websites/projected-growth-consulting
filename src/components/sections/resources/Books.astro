---
/**
 * Books & workbooks — Figma desktop 159:14856 / mobile 159:25358.
 * Desktop: 2 × 2 grid on the 1280 rail. Each entry is a navy #252c3a cover
 * plinth (Figma 628×542) with the jacket floated on it, then title / price /
 * blurb / Amazon CTA. Mobile stacks to one column.
 *
 * ponytail: Figma's second cover ("Action Guide For Social Media") renders
 * mirrored because one nested flip is missing on that layer only — a file bug,
 * not intent. All four are rendered upright here.
 */
import Button from '../../Button.astro';
import SectionHead from '../../SectionHead.astro';

type Book = {
  title: string;
  price: string;
  body: string;
  image: string;
  width: number;
  height: number;
};

const books: Book[] = [
  {
    title: 'Top 10 Profit Killers',
    price: '$29.97',
    body: 'Increase margins and eliminate common obstacles to growth.',
    image: '/images/resources/book-profit-killers.jpg',
    width: 311,
    height: 466,
  },
  {
    title: 'Action Guide For Social Media',
    price: '$29.99',
    body: 'A practical workbook for planning and implementing social media tips',
    image: '/images/resources/book-social-media.jpg',
    width: 630,
    height: 810,
  },
  {
    title: '1-Hour Sales Event Plan',
    price: '$6.99',
    body: 'Learn the exact process behind successful sales events and promotions.',
    image: '/images/resources/book-sales-event.png',
    width: 763,
    height: 930,
  },
  {
    title: '1-Hour Annual Marketing Plan',
    price: '$6.99',
    body: 'Build a complete marketing calendar in less time.',
    image: '/images/resources/book-marketing-plan.png',
    width: 697,
    height: 900,
  },
];

/* ponytail: Figma labels the CTA "Buy Now on Amazon" but carries no URL. A
   title+author search always resolves, so no product id is invented here. */
const amazon = (title: string) =>
  `https://www.amazon.com/s?k=${encodeURIComponent(`${title} Kelly Smith`)}`;

/* Figma: 0 400 112 rgba(0,0,0,0) / 0 256 103 .01 / 0 144 86 .05 / 0 64 64 .09 / 0 16 35 .1 */
const jacketShadow =
  'shadow-[0px_144px_86px_0px_rgba(0,0,0,0.05),0px_64px_64px_0px_rgba(0,0,0,0.09),0px_16px_35px_0px_rgba(0,0,0,0.1)]';
---

<section id="books" data-node-id="159:14856" class="bg-[#f6f3ec] py-20">
  <div class="rail flex flex-col gap-16">
    <div data-reveal>
      <SectionHead
        eyebrow="Books & Workbooks"
        title="Learn From Proven Industry Strategies"
        body="Written by Kelly Smith, these books and guides share the systems, frameworks, and lessons used to help thousands of practices grow."
      />
    </div>

    <ul data-reveal-group class="grid grid-cols-1 gap-x-6 gap-y-6 md:grid-cols-2 md:gap-y-8">
      {
        books.map((book) => (
          <li data-reveal class="flex flex-col gap-8">
            <div class="flex justify-center rounded-lg bg-[var(--color-navy)] px-9 py-[66px] lg:px-[85px]">
              <img
                src={book.image}
                alt={`Cover of ${book.title} by Kelly Smith`}
                width={book.width}
                height={book.height}
                loading="lazy"
                decoding="async"
                class:list={[
                  'aspect-[273/409] w-full max-w-[273px] rounded-[4px] object-cover',
                  jacketShadow,
                ]}
              />
            </div>

            <div class="flex flex-col gap-[52px]">
              <div class="flex flex-col gap-3">
                <h3 class="font-sans text-[3rem] leading-[56px] font-normal tracking-[-0.083em] text-[#111827]">
                  {book.title}
                </h3>
                <p class="font-sans text-[2.25rem] leading-11 tracking-[-0.083em] text-[#111827]">
                  {book.price}
                </p>
                {/* Figma tracks this line at -1px (= -0.05em at 20px), which is what
                    keeps all four blurbs on ONE line and the Amazon buttons aligned. */}
                <p class="text-xl leading-7 tracking-[-0.05em] text-[#6b7280]">
                  {book.body}
                </p>
              </div>

              <Button href={amazon(book.title)} size="lg" class="self-start">
                Buy Now on Amazon
                <span class="sr-only"> — {book.title}</span>
              </Button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

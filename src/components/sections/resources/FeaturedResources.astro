---
/**
 * "Most Popular" resource cards — Figma desktop 159:14810 / mobile 159:25311.
 * Desktop: 4 × 302px cards on the 1280 rail (gap 24). Mobile stacks them.
 * Figma reserves a fixed 56px (2-line) title box in every card so the bodies and
 * arrows line up — hence titleClass="lg:min-h-14".
 * Card chrome is #111827 with a lime 40px arrow pinned to the bottom.
 */
import SectionHead from '../../SectionHead.astro';
import DarkCard from '../../DarkCard.astro';

type Card = {
  title: string;
  body: string;
  image: string;
  width: number;
  height: number;
  /** object-contain in Figma — the artwork is a full cover, not a photo crop. */
  contain?: boolean;
};

const cards: Card[] = [
  {
    title: 'Free 7-Figure KPI Tracker',
    body: 'Track revenue, goals, bonuses, and performance metrics in minutes each week.',
    image: '/images/resources/card-kpi-tracker.png',
    width: 700,
    height: 700,
  },
  {
    title: 'PGC Growth App',
    body: 'Monitor KPIs, benchmarks, productivity, and financial performance from anywhere.',
    image: '/images/resources/card-growth-app.png',
    width: 1715,
    height: 1095,
  },
  {
    title: 'Aesthetics HR Success Kit',
    body: 'Simplify onboarding and create a stronger team culture.',
    image: '/images/resources/card-hr-kit.jpg',
    width: 650,
    height: 540,
  },
  {
    title: 'Top 10 Profit Killers',
    body: 'Identify hidden revenue leaks and improve profitability.',
    image: '/images/resources/card-profit-killers.png',
    width: 835,
    height: 1197,
    contain: true,
  },
];
---

<section data-node-id="159:14810" class="bg-[#f6f3ec] py-20">
  <div class="rail flex flex-col gap-12 lg:gap-16">
    <SectionHead
      eyebrow="Most Popular"
      title="Start With These Practice Essentials"
      body="The most downloaded and frequently used resources from the PGC community."
      cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    />

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        cards.map((card) => (
          <li>
            {/* ponytail: arrow is decorative — Figma ships no link target for these cards yet. */}
            <DarkCard
              image={card.image}
              width={card.width}
              height={card.height}
              imgClass={`h-[322px] w-full rounded-[4px] ${card.contain ? 'object-contain' : 'object-cover'}`}
              title={card.title}
              titleClass="min-h-14"
              body={card.body}
              arrow
              class="overflow-hidden"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

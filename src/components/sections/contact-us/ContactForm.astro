---
/**
 * Contact form — Figma desktop 184:2202 (1440x830) · mobile 184:4166 (393x1287).
 *
 * Desktop is a two-up: copy + contact details on the left, the form on the
 * right, 80px gap. Mobile keeps the same DOM order and stacks it.
 */
import Button from '../../Button.astro';
import { site } from '../../../lib/site';

const title = 'Still Have Questions?';

const contacts: { icon: string; label: string; href?: string }[] = [
  {
    icon: '/icons/mail.svg',
    label: site.contact.email,
    href: `mailto:${site.contact.email}`,
  },
  { icon: '/icons/phone.svg', label: site.contact.phone, href: `tel:${site.contact.phoneHref}` },
  { icon: '/icons/location.svg', label: `${site.contact.locality}, ${site.contact.country}` },
];

/**
 * ponytail: one env var, same pattern as the Calendly section. Set
 * PUBLIC_FORM_ENDPOINT to a POST handler (Formspree / Netlify / HubSpot / an
 * SSR route) and the real form ships; leave it unset and the panel falls back
 * to the direct contact routes.
 *
 * The fallback is not cosmetic. A `<form method="post">` with no `action`
 * re-requests the current page on a static host, so the browser shows a
 * success-looking reload and the enquiry is gone. Rendering no form at all is
 * the only honest state when there is nowhere to send it.
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
if (!endpoint) {
  console.warn(
    '[contact] PUBLIC_FORM_ENDPOINT is unset — /contact-us ships the direct-contact fallback instead of the form.'
  );
}

/* The eyebrow and intro name whatever is actually on the right. "Complete the
   form" next to no form is the kind of small lie that costs an enquiry. */
const eyebrow = endpoint ? 'CONTACT FORM' : 'GET IN TOUCH';
const body = endpoint
  ? 'Complete the form and a member of our team will get back to you as soon as possible.'
  : 'Email or call us and a member of our team will get back to you as soon as possible.';

type Field = {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'textarea';
  autocomplete: string;
  required?: boolean;
  /** Figma pairs first/last name in one row on desktop; everything else is full width. */
  half?: boolean;
};

const fields: Field[] = [
  { name: 'first-name', label: 'First name', type: 'text', autocomplete: 'given-name', required: true, half: true },
  { name: 'last-name', label: 'Last name', type: 'text', autocomplete: 'family-name', required: true, half: true },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email', required: true },
  // Figma marks no field as optional; phone stays optional so a missing number
  // never blocks a legitimate enquiry.
  { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
  { name: 'message', label: 'Message', type: 'textarea', autocomplete: 'off', required: true },
];

const control =
  'w-full rounded-lg border border-black/10 bg-white p-3 text-base leading-6 tracking-[-1px] text-[#111827]';
---

<section
  id="contact-form"
  data-node-id="184:2202"
  class="scroll-mt-24 bg-[#f6f3ec] py-20"
>
  <div data-reveal class="rail flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-20">
    <div class="flex flex-col gap-8 lg:min-w-0 lg:flex-1">
      <div class="flex flex-col gap-3">
        {/* Figma 184:2208 — 16px/20 Inter Regular at -1px, uppercase. */}
        <p class="eyebrow text-base leading-5 font-normal tracking-[-1px] text-[#111827]">
          {eyebrow}
        </p>
        <h2 class="text-[2.5rem] tracking-[-0.04em] text-[#111827] lg:text-[4rem]">
          {title}
        </h2>
        <p class="text-base leading-6 tracking-[-1px] text-[#6b7280] lg:max-w-[42ch]">
          {body}
        </p>
      </div>

      <ul class="flex flex-col gap-4 py-2">
        {
          contacts.map((c) => (
            <li class="flex min-w-0 items-start gap-4 text-base leading-6 text-[#6b7280]">
              <img
                src={c.icon}
                alt=""
                aria-hidden="true"
                width="24"
                height="24"
                loading="lazy"
                class="size-6 shrink-0"
              />
              {c.href ? (
                <a
                  href={c.href}
                  class="min-w-0 wrap-anywhere underline decoration-from-font underline-offset-2 transition-colors hover:text-[#111827]"
                >
                  {c.label}
                </a>
              ) : (
                <span>{c.label}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    {
      !endpoint && (
        <div class="flex flex-col gap-6 rounded-xl border border-black/10 bg-white p-8 lg:min-w-0 lg:flex-1">
          <h3 class="text-2xl leading-8 font-semibold tracking-[-1px] text-[#111827]">
            Reach us directly
          </h3>
          <p class="text-base leading-6 tracking-[-1px] text-[#6b7280]">
            Email or call and a member of the team will come back to you. Tell us
            your practice, where you are stuck, and the best time to reach you.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <Button href={`mailto:${site.contact.email}`}>Email Us</Button>
            <Button href={`tel:${site.contact.phoneHref}`} variant="secondary">
              Call {site.contact.phone}
            </Button>
          </div>
        </div>
      )
    }

    <form
      class:list={['flex flex-col gap-6 lg:min-w-0 lg:flex-1', !endpoint && 'hidden']}
      method="post"
      action={endpoint || undefined}
      aria-labelledby="contact-form-title"
      data-contact-form
    >
      <h3 id="contact-form-title" class="sr-only">Send us a message</h3>

      {/* Bots fill every field they can see; people never see this one. Cheaper
          and more accessible than a captcha, and the endpoint can drop any
          submission where it is non-empty. */}
      <div class="hidden" aria-hidden="true">
        <label for="company-website">Leave this field empty</label>
        <input id="company-website" name="company-website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          fields.map((f) => (
            <div class:list={['flex flex-col gap-2', !f.half && 'sm:col-span-2']}>
              <label
                for={f.name}
                class="text-base leading-6 tracking-[-1px] text-[#111827]"
              >
                {f.label}
              </label>
              {f.type === 'textarea' ? (
                <textarea
                  id={f.name}
                  name={f.name}
                  rows="6"
                  required={f.required}
                  class:list={[control, 'h-[180px] resize-y']}
                />
              ) : (
                <input
                  id={f.name}
                  name={f.name}
                  type={f.type}
                  autocomplete={f.autocomplete}
                  required={f.required}
                  class:list={[control, 'h-12']}
                />
              )}
            </div>
          ))
        }
      </div>

      <div class="flex items-start gap-2 pb-4">
        <input
          id="consent"
          name="consent"
          type="checkbox"
          required
          class="mt-1 size-[18px] shrink-0 rounded border border-black/10 bg-white accent-[var(--color-lime)]"
        />
        <!-- Figma I184:2248;4179:9061 — 14px at leading 1.5 (21px), not 24. -->
        <label for="consent" class="text-sm leading-normal text-[#6b7280]">
          I have read and agree to the <a
            href="/privacy-policy"
            class="text-[var(--color-lime)] underline decoration-from-font underline-offset-2">Privacy Policy</a
          >, and I consent to being contacted regarding my inquiry.
        </label>
      </div>

      <Button type="submit" class="w-full">Submit</Button>

      {/* Live region, not an alert() — the message has to reach a screen reader
          without stealing focus mid-form. */}
      <p
        data-form-status
        role="status"
        aria-live="polite"
        class="hidden text-base leading-6 tracking-[-1px]"
      >
      </p>
    </form>
  </div>
</section>

{
  endpoint && (
    <script>
      // Progressive enhancement only. With JS off the form is a plain POST to
      // `action` and the endpoint's own response page handles it — which is why
      // `action` is set in the markup rather than assigned here.
      function initContactForm() {
        const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
        if (!form || form.dataset.bound) return;
        form.dataset.bound = '1';
        const status = form.querySelector<HTMLElement>('[data-form-status]');
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        const say = (msg: string, ok: boolean) => {
          if (!status) return;
          status.textContent = msg;
          status.classList.remove('hidden');
          status.classList.toggle('text-[#111827]', ok);
          status.classList.toggle('text-[#b42318]', !ok);
        };

        form.addEventListener('submit', async (e) => {
          if (!form.reportValidity()) return;
          e.preventDefault();
          submit?.setAttribute('disabled', '');
          say('Sending…', true);
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) throw new Error(String(res.status));
            form.reset();
            say("Thanks — your message is on its way. We'll be in touch shortly.", true);
          } catch {
            // Never swallow it: the visitor gets a route that still works.
            say(
              'That did not send. Please email us directly and we will pick it up from there.',
              false
            );
          } finally {
            submit?.removeAttribute('disabled');
          }
        });
      }
      document.addEventListener('astro:page-load', initContactForm);
    </script>
  )
}

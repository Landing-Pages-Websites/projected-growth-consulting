---
/**
 * "What We Believe" — Figma 159:6861 (desktop 1440x688) / 159:22665 (mobile 393x1712).
 *
 * Desktop: split header (659px title column / 561px right-aligned body + CTA)
 * over four 302px dark cards on a 24px gutter.
 * Mobile centres the header and stacks the cards full width.
 */
import SectionHead from '../../SectionHead.astro';
import IconCard from '../../IconCard.astro';

const beliefs = [
  {
    icon: '/icons/belief-1.svg',
    title: 'Systems Over Guesswork',
    body: 'Build repeatable processes instead of relying on intuition.',
  },
  {
    icon: '/icons/belief-2.svg',
    title: 'Numbers Drive Decisions',
    body: 'The right KPIs reveal where growth opportunities exist.',
  },
  {
    icon: '/icons/belief-3.svg',
    title: 'Leadership Creates Scale',
    body: 'Strong businesses are built by strong teams and accountability.',
  },
  {
    icon: '/icons/belief-4.svg',
    title: 'Sustainable Beats Fast',
    body: 'Long-term profitability matters more than short-term wins.',
  },
];
---

<section data-node-id="159:6861" class="bg-[#f6f3ec] py-20">
  <div class="rail flex flex-col gap-16">
    <SectionHead
      eyebrow="Our Approach"
      title="Growth Happens When Strategy Meets Execution."
      body="The principles that guide every recommendation, framework, and growth strategy we deliver to practice owners."
      cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    />

    <ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        beliefs.map((belief) => (
          <IconCard icon={belief.icon} title={belief.title} body={belief.body} />
        ))
      }
    </ul>
  </div>
</section>

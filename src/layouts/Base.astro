---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Footer CTA card — off for pages that already close with a CTA. */
  cta?: boolean;
  ogImage?: string;
  /** Keep a page out of the index until its real content lands (blog drafts). */
  noindex?: boolean;
  /** 'light' for pages whose hero is the cream, image-less variant — the
      overlaid header is cream-on-dark by default and vanishes on those. */
  headerTheme?: 'dark' | 'light';
}

const {
  title,
  description = site.description,
  cta = true,
  ogImage = '/images/home-hero.jpg',
  noindex = false,
  headerTheme = 'dark',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;

const origin = (Astro.site ?? new URL(site.url)).origin;

/**
 * Organization + WebSite, emitted once on every route — Charter §6 roadmap
 * item 2. Every field is a fact already published on this site (site.ts /
 * /contact-us); nothing is inferred. `sameAs` is omitted entirely rather than
 * filled with guesses, and only appears once real profile URLs land in site.ts.
 */
const sameAs = [site.social.instagram, site.social.linkedin].filter(Boolean);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${origin}/#organization`,
  name: site.name,
  url: origin,
  description: site.description,
  slogan: site.tagline,
  logo: { '@type': 'ImageObject', url: new URL('/images/logo-wordmark.svg', origin).href },
  email: site.contact.email,
  telephone: site.contact.phoneHref,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.contact.locality,
    addressRegion: site.contact.region,
    addressCountry: site.contact.country,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: site.contact.phoneHref,
    email: site.contact.email,
    areaServed: site.contact.country,
    availableLanguage: 'en',
  },
  ...(sameAs.length ? { sameAs } : {}),
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  name: site.name,
  url: origin,
  inLanguage: 'en-US',
  publisher: { '@id': `${origin}/#organization` },
};

const ld = JSON.stringify([orgLd, siteLd]).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set .js before first paint so entrance effects hide content only when JS
        can reveal it again (no-JS renders everything visible, no FOUC). The
        after-swap re-apply keeps it set through client-side view transitions,
        which otherwise reset <html> and would leave content un-animated. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () =>
        document.documentElement.classList.add('js')
      );
    </script>
    <ClientRouter />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* max-image-preview:large is what lets a photo, not a thumbnail, appear in
        Discover and image-rich results. Without an explicit robots tag Google
        assumes `standard`. */}
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? site.url).href} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#252c3a" />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" is:inline set:html={ld} />

    <!-- ponytail: CDN fonts. Self-host + preload when Core Web Vitals matter,
         and swap Newsreader for the licensed Tiempos Headline files. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,300..700&display=swap"
    />

    {/* Charter §6 roadmap item 3. Env-gated like every other integration here,
        so launch day is a variable, not a code change. Unset = no requests, no
        cookies, no consent surface to manage. */}
    {
      import.meta.env.PUBLIC_GA4_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}
          />
          <script is:inline define:vars={{ id: import.meta.env.PUBLIC_GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
            // View transitions swap the document without a real navigation, so
            // GA would only ever record the landing page without this.
            document.addEventListener('astro:page-load', () =>
              gtag('event', 'page_view', { page_path: location.pathname })
            );
          </script>
        </>
      )
    }

    {/* Search Console HTML-tag verification, if that method is chosen over DNS. */}
    {
      import.meta.env.PUBLIC_GSC_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GSC_VERIFICATION}
        />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-[var(--color-lime)] focus:px-4 focus:py-2 focus:text-[var(--color-navy)]"
      >Skip to content</a
    >
    <Header theme={headerTheme} />
    <main id="main">
      <slot />
    </main>
    <Footer cta={cta} />

    <script>
      // Site-wide motion: scroll-reveal + stat count-up. Declarative — sections
      // opt in with data-reveal / data-countup; all observer logic lives here so
      // the 14 pages never hand-roll their own. Re-runs after every view-transition
      // navigation via astro:page-load (fires on the initial load too).
      function initMotion() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ---- Scroll reveal ---------------------------------------------------
        const all = Array.from(
          document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)')
        );
        if (reduce) {
          all.forEach((el) => el.classList.add('is-revealed'));
        } else {
          // De-nest: a [data-reveal] inside another [data-reveal] would stay
          // invisible while its ancestor is still at opacity 0 (opacity hides the
          // whole subtree), and fast scroll can leave the ancestor unrevealed.
          // Reveal nested ones up front — the ancestor animates the block as one.
          const nested = new Set(
            all.filter((el) => el.parentElement?.closest('[data-reveal]'))
          );
          nested.forEach((el) => el.classList.add('is-revealed'));
          const reveals = all.filter((el) => !nested.has(el));

          // Auto-stagger direct reveals inside a [data-reveal-group] (top-level only).
          document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
            group.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => {
              if (reveals.includes(el) && !el.style.getPropertyValue('--reveal-delay')) {
                el.style.setProperty('--reveal-delay', `${Math.min(i, 8) * 70}ms`);
              }
            });
          });

          // A rAF-throttled scroll sweep, not IntersectionObserver: IO reports the
          // final settled scroll position, so a fast fling from top to bottom can
          // leave mid-page reveals un-fired (they'd sit blank until scrolled back).
          // Checking real geometry each frame reveals reliably at any scroll speed.
          let pending = reveals;
          let ticking = false;
          const sweep = () => {
            ticking = false;
            const line = window.innerHeight * 0.92;
            pending = pending.filter((el) => {
              if (el.getBoundingClientRect().top < line) {
                el.classList.add('is-revealed');
                return false;
              }
              return true;
            });
            if (!pending.length) {
              window.removeEventListener('scroll', onScroll);
              window.removeEventListener('resize', onScroll);
            }
          };
          const onScroll = () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(sweep);
            }
          };
          sweep(); // reveal whatever is in view on load
          if (pending.length) {
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
          }
        }

        // ---- Stat count-up ---------------------------------------------------
        // data-countup wraps ONLY the numeric text (never the coloured suffix
        // span), so animating textContent can't destroy sibling markup.
        const nums = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-done])');
        if (nums.length && !reduce) {
          const io2 = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((e) => {
                if (!e.isIntersecting) return;
                obs.unobserve(e.target);
                runCountUp(e.target as HTMLElement);
              });
            },
            { threshold: 0.6 }
          );
          nums.forEach((el) => io2.observe(el));
        }
      }

      function runCountUp(el: HTMLElement) {
        el.setAttribute('data-countup-done', '');
        const raw = (el.textContent ?? '').trim();
        const m = raw.match(/^(\D*)([\d,]+(?:\.\d+)?)(.*)$/s);
        if (!m) return;
        const [, pre, numStr, suf] = m;
        const hasComma = numStr.includes(',');
        const decimals = (numStr.split('.')[1] ?? '').length;
        const target = parseFloat(numStr.replace(/,/g, ''));
        if (!isFinite(target)) return;

        const fmt = (v: number) => {
          let s = decimals ? v.toFixed(decimals) : String(Math.round(v));
          if (hasComma) s = Number(s).toLocaleString('en-US');
          return pre + s + suf;
        };
        const duration = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(target * eased);
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = pre + numStr + suf; // exact original, incl. commas
        };
        requestAnimationFrame(tick);
      }

      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>

/* Figma only expands the first accordion item, so only its answer exists in the
   design. The remaining seven answers are assembled from copy that already
   appears on this page (program cards, What's Included lists, Program
   Highlights, the Process steps) rather than invented. */
const faqs = [
  {
    q: 'How do I know which coaching program is right for me?',
    a: 'Executive Coaching is ideal for personalized support, Growth Accelerator focuses on implementation and accountability, while Mastermind is designed for peer collaboration and advanced strategy.',
  },
  {
    q: 'Who is the Business Startup Program designed for?',
    a: 'New practices and entrepreneurs preparing to launch. It helps you launch your practice with confidence through expert planning, financial guidance, operational setup, and industry-specific support.',
  },
  {
    q: 'What does the Startup Program include?',
    a: 'Business planning, financial modeling, location and real estate, services, pricing and memberships, operations and team development, and marketing and growth strategy — plus 10+ hours of 1-on-1 startup consulting and 25–50+ hours dedicated to building a custom business plan for lenders, investors, and growth.',
  },
  {
    q: 'Is Aesthetic Medical Coaching only for med spas?',
    a: 'No. It is built for established elective medical practices ready to scale, working directly with experienced advisors to improve profitability, leadership, marketing, operations, and long-term growth.',
  },
  {
    q: 'How is coaching different from an online course?',
    a: 'Coaching is personalized. We evaluate your practice, build a tailored roadmap around your goals and growth stage, and stay with you through implementation, rather than leaving you to work through material on your own.',
  },
  {
    q: 'Will I receive customized recommendations?',
    a: 'Yes. Every engagement is customized around your practice’s goals, challenges, and growth stage — creating a strategic roadmap backed by hands-on consulting and proven industry expertise.',
  },
  {
    q: 'Can you help improve profitability and operations?',
    a: 'Yes. Aesthetic Medical Coaching covers revenue optimization to increase profitability across your practice and operational efficiency to improve systems and workflows, supported by KPI management so you track the metrics that matter most.',
  },
  {
    q: 'How long do consulting engagements typically last?',
    a: 'It depends on the program. The Business Startup Program includes 10+ hours of 1-on-1 startup consulting and 25–50+ hours dedicated to business plan development, while Aesthetic Medical Coaching is ongoing guidance through implementation and scale.',
  },
];
---

<Base
  title="Consulting"
  description="Consulting for elective medical practices. The Business Startup Program and Aesthetic Medical Coaching give owners the strategy, systems, and support to build a more profitable business."
  ogImage="/images/heroes/consulting.jpg"
>
  <PageHero
    nodeId="159:13186"
    title="Expert Guidance For Every Stage"
    body="Whether you're launching a new practice or scaling an existing one, our consulting services provide the strategy, systems, and support needed to build a more profitable business."
    image="/images/heroes/consulting.jpg"
    primaryCta={{ label: 'Book A MedSpa Consulting Call', href: '/book-a-call' }}
    secondaryCta={{ label: 'Browse Courses', href: '/courses' }}
  />

  <StatsBar
    nodeId="159:13224"
    intro="Helping elective medical practices grow with proven systems, coaching, and accountability."
    stats={heroStats}
    spread
  />

  <ChoosePath
    eyebrow="Two Ways To Work With PGC"
    title="Support Tailored To Your Goals"
    body="From startup planning to growth acceleration, our consulting services are designed to help practice owners make smarter decisions and achieve better outcomes."
    cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    cards={paths}
  />

  <ProgramDetail
    id="business-startup-program"
    nodeId="159:13272"
    eyebrow="Business Startup Program"
    title="Build Your Practice The Right Way"
    body="Avoid costly mistakes and launch with a clear plan. The Business Startup Program provides expert guidance, financial planning, and industry-specific resources to help you create a successful foundation."
    includedLabel="What's Included :"
    items={startupIncludes}
    image="/images/consulting/business-startup-program.jpg"
    imageAlt="Practice owner planning a new clinic launch with a PGC consultant"
    imageWidth={1280}
    imageHeight={822}
    cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
  />

  <StatsBar nodeId="159:13327" heading="Program Highlights" stats={programHighlights} spread />

  <ProgramDetail
    id="aesthetic-medical-coaching"
    nodeId="159:13340"
    eyebrow="Aesthetic Medical Coaching"
    title="Accelerate Growth With Expert Coaching"
    body="Receive personalized guidance to improve profitability, strengthen leadership, optimize operations, and create sustainable long-term growth."
    includedLabel="What's Included :"
    items={coachingIncludes}
    image="/images/consulting/aesthetic-medical-coaching.jpg"
    imageAlt="Aesthetic medical practice owner in a one-to-one coaching session"
    imageWidth={853}
    imageHeight={1280}
    cta={{ label: 'Schedule A Call', href: '/book-a-call' }}
    reverse
  />

  <Process
    nodeId="159:13395"
    eyebrow="Our Process"
    title="A Clear Strategy. Expert Guidance. Measurable Results."
    body="Every engagement is customized around your practice's goals, challenges, and growth stage—creating a strategic roadmap backed by hands-on consulting and proven industry expertise."
    cta={{ label: 'Join The Growth Hub', href: '/growth-hub' }}
    steps={processSteps}
    imageClass="h-[256px] sm:h-[272px]"
  />

  <FAQ
    nodeId="159:14572"
    eyebrow="Frequently Asked Questions"
    title="Questions About Our Consulting Services?"
    body="Learn more about the Business Startup Program, Aesthetic Medical Coaching, and how PGC helps practice owners build stronger, more profitable businesses."
    ctaLabel="Schedule A Call"
    ctaHref="/book-a-call"
    ctaClass="mt-6"
    items={faqs}
  />
</Base>

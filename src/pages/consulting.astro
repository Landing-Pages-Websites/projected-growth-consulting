  { value: '15+', label: 'Years of Industry Experience' },
  { value: '92%', label: 'Members Renew Annually' },
];

/* Figma 159:13330 fixes each column's width and alignment: 188 left, 265 centred,
   244 right, space-between across the 1280 rail. */

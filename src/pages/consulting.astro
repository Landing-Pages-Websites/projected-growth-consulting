  { value: '10+', label: 'Hours of 1-on-1 startup consulting.', class: 'lg:w-[188px]' },
  {
    value: '25–50+',
    label: 'Hours dedicated to business plan development.',
    class: 'lg:w-[265px] lg:text-center',
  },
  {
    value: 'Custom',
    label: 'Business plan built for lenders, investors, and growth.',
    class: 'lg:w-[244px] lg:text-right',
  },
];

const paths = [
  {
    bestFor: 'Best For: New practices and entrepreneurs preparing to launch.',
    title: 'Business Startup Program',
    body: 'Launch your practice with confidence through expert planning, financial guidance, operational setup, and industry-specific support.',
    href: '#business-startup-program',
    image: '/images/consulting/path-business-startup.jpg',
    imageAlt: 'Consultant reviewing launch plans with a new practice owner',
  },
  {
    bestFor: 'Best For: Established practices ready to scale.',
    title: 'Aesthetic Medical Coaching',
    body: 'Work directly with experienced advisors to improve profitability, leadership, marketing, operations, and long-term growth.',
    href: '#aesthetic-medical-coaching',
    image: '/images/consulting/path-aesthetic-coaching.jpg',
    imageAlt: 'Aesthetic practice team working through a growth session with a PGC advisor',
  },
];

const startupIncludes = [
  { term: 'Business Planning :', text: 'Create a clear vision, business plan, and funding strategy.' },
  {
    term: 'Financial Modeling :',
    text: 'Build startup budgets, forecasts, and profitability projections.',
  },
  {
    term: 'Location & Real Estate :',

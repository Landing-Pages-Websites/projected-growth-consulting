    text: 'Develop profitable offerings, pricing structures, and recurring revenue programs.',
  },
  {
    term: 'Operations & Team Development :',
    text: 'Establish staffing plans, SOPs, HR systems, and operational workflows.',
  },
  {
    term: 'Marketing & Growth Strategy :',
    text: 'Launch with a proven marketing plan, KPIs, and growth roadmap.',
  },
];

const coachingIncludes = [
  { term: 'Strategic Planning :', text: 'Create a roadmap for sustainable growth.' },
  { term: 'Revenue Optimization :', text: 'Increase profitability across your practice.' },
  { term: 'Leadership Development :', text: 'Build stronger teams and accountability.' },
  { term: 'Marketing Performance :', text: 'Improve lead quality and conversions.' },
  { term: 'KPI Management :', text: 'Track the metrics that matter most.' },
  { term: 'Operational Efficiency :', text: 'Improve systems and workflows.' },
];

const processSteps = [
  {
    title: 'Discover & Assess',
    body: 'We evaluate your practice, financials, operations, goals, and current challenges to identify the highest-impact opportunities.',
    image: '/images/consulting/process-discover-assess.jpg',
    imageAlt: 'PGC advisors assessing a practice’s financials and operations',
  },
  {
    title: 'Build Your Strategy',
    body: 'Together, we create a tailored consulting roadmap with clear priorities, measurable milestones, and practical solutions aligned with your vision.',
  },
  {
    title: 'Implement & Optimize',

---
/**
 * /press — Figma desktop 159:16590 · mobile 159:25870.
 * Sections: Hero · Stats · About Kelly · Choose Your Path · Podcast ·
 *           Seminar Topics · FAQs · Footer (Base).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StatsBar from '../components/StatsBar.astro';
import FAQ from '../components/FAQ.astro';
import type { FaqItem } from '../components/FAQ.astro';
import AboutKelly from '../components/sections/press/AboutKelly.astro';
import ChooseYourPath from '../components/sections/press/ChooseYourPath.astro';
import Podcast from '../components/sections/press/Podcast.astro';
import SeminarTopics from '../components/sections/press/SeminarTopics.astro';

const heroBody =
  'International speaker, bestselling author, and Founder of Projected Growth Consulting. Kelly has helped more than 6,000 elective medical practices improve profitability, increase valuation, and create sustainable growth.';

/* The hero body runs 220 chars — Google cuts a description at ~160. Same claims,
   trimmed to fit; the on-page copy is untouched. */
const metaDescription =
  'International speaker, bestselling author and Founder of Projected Growth Consulting. Kelly Smith has helped more than 6,000 elective medical practices.';

const stats = [
  { value: '6,000+', label: 'Practice Owners Supported' },
  { value: '$250M+', label: 'Client Revenue Generated' },
  { value: '15+', label: 'Years of Industry Experience' },
  { value: '92%', label: 'Members Renew Annually' },
];

/* Figma 159:19016 lists six questions but only paints the answer to the first
   (the rest are drawn collapsed). Answers 2-6 are written from copy that already
   appears on this page — no new claims, stats or names. */
const faqs: FaqItem[] = [
  {
    q: 'What topics does Kelly Smith speak on?',
    a: 'Kelly regularly presents on practice growth, leadership, recruiting, memberships, KPIs, profitability, sales events, marketing strategy, and practice valuation.',
  },
  {
    q: "Who are Kelly's presentations designed for?",
    a: 'Aesthetic and elective medical practice owners and their leadership teams — med spas, plastic surgery, functional medicine, and wellness businesses at every stage of growth.',
  },
  {
    q: 'Are presentations customized for each event?',
    a: 'Yes. Every session is built on the same proven frameworks and real-world case studies, then tailored to the audience and the goals of the event.',
  },
  {
    q: 'Is Kelly available for keynote presentations?',
    a: 'Yes. Kelly speaks at conferences, workshops, and industry events, including keynote sessions for practice owners and leadership teams.',
  },
  {
    q: 'Does Kelly participate in podcasts and interviews?',
    a: 'Yes. Kelly regularly joins podcasts and interviews alongside her conference, workshop, and industry event schedule.',
  },
  {
    q: "What makes Kelly's presentations different?",
    a: 'They come from operating experience rather than theory — the same systems used with more than 6,000 elective medical practices, presented with the metrics and implementation steps owners can apply immediately.',
  },
];
---

<Base
  title="Press &amp; Speaking"
  description={metaDescription}
  ogImage="/images/press/hero.jpg"
>
  <PageHero
    nodeId="159:16591"
    title="Industry Insights From Kelly Smith"
    body={heroBody}
    image="/images/press/hero.jpg"
    imageAlt="Kelly Smith recording at her desk beside a podcast microphone and copies of her book Top 10 Profit Killers"
    primaryCta={{ label: 'Book A MedSpa Consulting Call', href: '/book-a-call' }}
    secondaryCta={{ label: 'Browse Courses', href: '/courses' }}
  />

  <StatsBar
    nodeId="159:16629"
    stats={stats}
    spread
    intro="Helping elective medical practices grow with proven systems, coaching, and accountability."
  />

  <AboutKelly />
  <ChooseYourPath />
  <Podcast />
  <SeminarTopics />

  <div data-reveal>
    <FAQ
      nodeId="159:19003"
      items={faqs}
      eyebrow="Frequently Asked Questions"
      title="Questions About Speaking & Media?"
      body="Everything you need to know about booking Kelly Smith for conferences, workshops, podcasts, leadership events, and industry presentations.or using our tools."
      ctaClass="mt-6"
    />
  </div>
</Base>

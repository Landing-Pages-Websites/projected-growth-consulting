---
/**
 * /blog/med-spa-kpis-dashboard-guide — Figma desktop 184:5329 / mobile 184:4777.
 * Hero · Content · Footer (Footer comes from Base; its CTA copy matches the
 * site default, so nothing is overridden).
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/blog-post/Hero.astro';
import Article from '../../components/sections/blog-post/Article.astro';
import { site } from '../../lib/site';

const title = 'Med Spa KPIs: The Owner’s Dashboard Guide';
const description =
  'The med spa KPIs that belong on an owner’s dashboard — what to review weekly, which financial metrics need a monthly close, and how to turn each number into an owner, an action, and a due date.';
const category = 'Financial';
const published = { label: '20 June 2026', iso: '2026-06-20' };
const readTime = '5 Min';
const author = {
  name: 'Kelly Smith',
  avatar: '/images/blog-post/kelly-smith-avatar.png',
};
const image = '/images/blog-post/med-spa-kpis-hero.png';

const origin = (Astro.site ?? new URL(site.url)).origin;
const url = new URL(Astro.url.pathname, origin).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: new URL(image, origin).href,
    articleSection: category,
    datePublished: published.iso,
    dateModified: published.iso,
    inLanguage: 'en-US',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Person', name: author.name, url: `${origin}/about` },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: origin,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/images/logo-wordmark.svg', origin).href,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={title} description={description} ogImage={image}>
  <Fragment slot="head">
    {/* Base already emits og:type=website; a second one would just conflict. */}
    <meta property="article:published_time" content={published.iso} />
    <meta property="article:author" content={author.name} />
    <meta property="article:section" content={category} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>

  <Hero
    title={title}
    category={category}
    published={published}
    readTime={readTime}
    author={author}
    image={image}
    imageAlt="A med spa provider reviewing her practice dashboard on a laptop in the treatment suite lounge."
  />

  <Article />
</Base>

---
/**
 * Article shells for the posts that exist on the /blog index but were never
 * designed or written. Only one article (med-spa-kpis-dashboard-guide) has a
 * Figma design and real copy; it keeps its own hand-built page and is excluded
 * from getStaticPaths below.
 *
 * These pages deliberately DO NOT pretend to be finished:
 *   - noindex until real copy lands, so a stub never enters the index
 *   - no Article JSON-LD (publishing schema for a body that doesn't exist would
 *     put a fabricated article into the SERP — same reasoning as the FAQ gate)
 *   - a visible draft notice instead of invented med-spa business advice
 * Replace the body with the real article and delete the draft block; the
 * checklist in HANDOFF.md says exactly what to flip.
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/blog-post/Hero.astro';
import Button from '../../components/Button.astro';
import { posts, author } from '../../lib/posts';

export function getStaticPaths() {
  return posts
    .filter((p) => p.slug !== 'med-spa-kpis-dashboard-guide') // has a real designed page
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

/* The outline a writer fills in. Structural only — no claims, no advice. */
const outline = [
  'Why this matters for your practice',
  'What to measure',
  'How to put it into practice',
  'Common mistakes to avoid',
  'Next steps',
];
---

<Base
  title={post.title}
  description={post.excerpt}
  ogImage={post.image}
  noindex
>
  <Hero
    title={post.title}
    category={post.category}
    published={{ label: post.dateLabel, iso: post.date }}
    readTime={post.readingTime}
    author={{ name: author.name, avatar: author.avatar }}
    image={post.image}
    imageAlt={post.title}
  />

  <section class="py-20" data-draft>
    <div class="rail flex flex-col gap-20 lg:flex-row lg:items-start">
      <div class="flex w-full flex-col gap-8 lg:min-w-0 lg:flex-1">
        <div class="rounded-xl border border-[var(--color-lime-border)] bg-[var(--color-lime)]/15 p-6">
          <p class="text-lg leading-8 font-semibold tracking-[-1px] text-[#111827]">
            This article hasn’t been written yet.
          </p>
          <p class="mt-2 text-base leading-6 tracking-[-1px] text-[#6b7280]">
            The layout, metadata and hero image are ready. The body copy is
            waiting on the author — this page is set to <code>noindex</code> and
            publishes no article schema until it lands.
          </p>
        </div>

        <div class="flex flex-col gap-6">
          <h2 class="text-[2rem] lg:text-[2.5rem]">Planned outline</h2>
          <ol class="flex flex-col gap-4">
            {
              outline.map((heading, i) => (
                <li class="flex gap-4 border-b border-[#e4e4e7] pb-4">
                  <span class="font-display text-xl leading-8 text-[#6b7280]">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-lg leading-8 font-medium tracking-[-1px] text-[#111827]">
                    {heading}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <aside class="flex w-full flex-col gap-6 lg:sticky lg:top-8 lg:basis-[464px] lg:min-w-0">
        <div class="rounded-xl bg-[#111827] p-8">
          <p class="text-2xl leading-8 font-semibold tracking-[-1px] text-white">
            Read the one that’s ready
          </p>
          <p class="mt-3 text-base leading-6 tracking-[-1px] text-[#6b7280]">
            Our Med Spa KPI dashboard guide covers the numbers to review weekly
            and the ones that need a monthly close.
          </p>
          <Button href="/blog/med-spa-kpis-dashboard-guide" class="mt-6">
            Read The KPI Guide
          </Button>
        </div>
        <a
          href="/blog"
          class="text-base leading-6 font-medium tracking-[-1px] text-[#111827] underline underline-offset-4 transition-colors hover:text-[var(--color-lime-border)]"
        >
          ← Back to all articles
        </a>
      </aside>
    </div>
  </section>
</Base>

# build output
dist/
.astro/

# dependencies
node_modules/

# env & secrets — never commit. No negation here on purpose: the template is
# `env.example` (no leading dot) so nothing matching .env* can ever be exempted.
.env
.env.*
*.pem
*.key

# pre-optimisation image originals, kept locally only
.backup-lowres/

# os / editor
.DS_Store
*.log
npm-debug.log*

# working backup of superseded low-res heroes
.backup-lowres/
